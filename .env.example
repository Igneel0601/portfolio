# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Site origin (canonical URL, sitemap, robots, rss) ──────────
# Single source of truth for the public domain. Change here (or in Vercel)
# when the domain changes, then redeploy — no code edits. Defaults to
# https://portfolio.igneel.cloud in lib/site.ts if unset.
SITE_URL=https://portfolio.igneel.cloud

# ─── Neon Postgres (shared with bloggz CMS) ─────────────────────
# Pooled connection — used by portfolio to read posts
DATABASE_URI=postgresql://USER:PASS@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional — only used to resolve relative media URLs (local bloggz uploads).
# In prod, host media on S3/R2 with absolute URLs and leave this unset.
BLOGGZ_URL=http://localhost:3001

# ─── Groq (for /terminal `ollama run` command) ──────────────────
# Free tier, no card needed. console.groq.com → API Keys.
GROQ_API_KEY=gsk_yourkeyhere
