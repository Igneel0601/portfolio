# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Payload CMS (Neon Postgres) ────────────────────────────────
# Pooled connection — used at runtime by Payload for queries
DATABASE_URI=postgresql://USER:PASS@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct connection — used by Payload for migrations / schema changes
DIRECT_DATABASE_URI=postgresql://USER:PASS@HOST.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Payload session secret — generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-base64-32-bytes
