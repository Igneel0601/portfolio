"use client";

import { useEffect, useRef, useState } from "react";
import { PROJECTS } from "@/lib/content";
import { ProjectCardLarge } from "@/components/ProjectCard";
import { gsap, ScrollTrigger } from "@/lib/gsap";
import { motionMM, MOTION_BREAKPOINTS } from "@/lib/match-media";
import { D, E } from "@/lib/motion-tokens";

// Per-project accent for the curtain seam/label strip.
const CURTAIN_TINTS = ["#FF7A59", "#9B6BFF", "#5BA8FF"];

export function ScenePinnedWork() {
  const rootRef = useRef<HTMLElement | null>(null);
  const cardWrapRef = useRef<HTMLDivElement | null>(null);
  const panelRefs = useRef<(HTMLDivElement | null)[]>([]);
  const seamRef = useRef<HTMLDivElement | null>(null);
  const stRef = useRef<ScrollTrigger | null>(null);
  const [activeIdx, setActiveIdx] = useState(0);
  const activeIdxRef = useRef(0);

  // entry reveal once on viewport enter
  useEffect(() => {
    if (!rootRef.current) return;
    const root = rootRef.current;
    const mm = motionMM();

    mm.add(MOTION_BREAKPOINTS, (ctx) => {
      const { isReduce } = ctx.conditions as { isReduce: boolean };
      const label = root.querySelector<HTMLElement>("[data-section-label]");
      const title = root.querySelector<HTMLElement>("[data-section-title]");
      const eyebrow = root.querySelector<HTMLElement>("[data-pin-meta]");
      const rows = gsap.utils.toArray<HTMLElement>("[data-ls-row]", root);
      const foot = gsap.utils.toArray<HTMLElement>("[data-ls-foot]", root);
      const lsBox = root.querySelector<HTMLElement>("[data-ls-box]");
      const card = cardWrapRef.current;

      if (isReduce) {
        gsap.set([label, title, eyebrow, ...rows, ...foot, lsBox, card].filter(Boolean), {
          autoAlpha: 1,
          x: 0,
          y: 0,
        });
        return;
      }

      gsap.set([label, eyebrow].filter(Boolean), { autoAlpha: 0, y: -8 });
      gsap.set(title, { autoAlpha: 0, y: 16 });
      gsap.set(card, { autoAlpha: 0, y: 16 });
      gsap.set(lsBox, { autoAlpha: 0, y: 16 });
      gsap.set(rows, { autoAlpha: 0, x: -8 });
      gsap.set(foot, { autoAlpha: 0, y: 6 });

      gsap.timeline({
        scrollTrigger: { trigger: root, start: "top 75%", once: true },
        defaults: { ease: E.precise },
      })
        .to([label, eyebrow].filter(Boolean), { autoAlpha: 1, y: 0, duration: 0.4 })
        .to(title, { autoAlpha: 1, y: 0, duration: D.md }, "-=0.20")
        .to([card, lsBox], { autoAlpha: 1, y: 0, duration: D.md, stagger: 0.05 }, "-=0.30")
        .to(rows, { autoAlpha: 1, x: 0, duration: D.sm, stagger: 0.05 }, "-=0.20")
        .to(foot, { autoAlpha: 1, y: 0, duration: D.sm, stagger: 0.05 }, "-=0.20");

      // Curtain reveal: pin scene, drive N-1 panel reveals across the runway.
      // Project 0 starts visible. Project i (i>0) translates yPercent 100 -> 0
      // during its own segment of the scroll.
      const transitions = Math.max(1, PROJECTS.length - 1);

      const queryPanels = () =>
        Array.from(root.querySelectorAll<HTMLElement>("[data-curtain-panel]")).sort(
          (a, b) => Number(a.dataset.curtainPanel) - Number(b.dataset.curtainPanel),
        );

      const applyClip = (panels: HTMLElement[], seg: number, local: number) => {
        for (let j = 0; j < panels.length; j++) {
          let clip: string;
          if (j < seg) clip = "inset(100% 0 0 0)";
          else if (j === seg) clip = `inset(0 0 ${(local * 100).toFixed(2)}% 0)`;
          else if (j === seg + 1) clip = `inset(${((1 - local) * 100).toFixed(2)}% 0 0 0)`;
          else clip = "inset(100% 0 0 0)";
          panels[j].style.clipPath = clip;
        }
      };

      const applySeam = (seg: number, local: number) => {
        const seam = seamRef.current;
        if (!seam) return;
        const incoming = PROJECTS[seg + 1];
        if (!incoming || local <= 0) {
          seam.style.opacity = "0";
          return;
        }
        // seam sits at the clip line (top of revealing panel's visible region)
        seam.style.opacity = "1";
        seam.style.top = `${((1 - local) * 100).toFixed(2)}%`;
        seam.style.background = CURTAIN_TINTS[seg + 1];
        seam.textContent = incoming.name.toLowerCase();
      };

      // initial state
      applyClip(queryPanels(), 0, 0);
      applySeam(0, 0);

      stRef.current = ScrollTrigger.create({
        trigger: root,
        pin: true,
        start: "top top",
        end: `+=${transitions * 100}%`,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        scrub: isReduce ? false : 0.4,
        onUpdate: (self) => {
          const p = self.progress;
          const f = p * transitions;
          const seg = Math.min(transitions - 1, Math.floor(f * 0.9999));
          const local = Math.min(1, Math.max(0, f - seg));

          applyClip(queryPanels(), seg, local);
          applySeam(seg, local);

          // active index = the topmost panel that's at least 50% covering
          const idx = local > 0.5 ? seg + 1 : seg;
          const clamped = Math.min(PROJECTS.length - 1, Math.max(0, idx));
          if (clamped !== activeIdxRef.current) {
            activeIdxRef.current = clamped;
            setActiveIdx(clamped);
          }
        },
      });
    });

    return () => mm.revert();
  }, []);

  // (curtain handles project transitions; no swap animation needed)

  return (
    <section
      ref={rootRef}
      data-scene="work"
      id="work"
      className="relative px-6 md:px-10 py-12 min-h-screen flex items-center"
    >
      <div className="max-w-6xl mx-auto w-full">
        <div className="flex items-start justify-between mb-6">
          <div>
            <h2 className="serif text-3xl md:text-4xl font-extrabold" data-section-title>
              Three things I shipped.
            </h2>
          </div>
          <span className="mono mute text-[11px] tracking-[0.18em]" data-pin-meta>
            CLICK A FILE →
          </span>
        </div>

        <div
          className="grid gap-5 md:gap-8 items-start"
          style={{ gridTemplateColumns: "minmax(0, 1.2fr) minmax(0, 1fr)" }}
        >
          {/* LEFT — curtain stage: panels overlap; clip-path wipes between them */}
          <div
            ref={cardWrapRef}
            className="curtain-stage"
            style={{ position: "relative", isolation: "isolate" }}
          >
            {PROJECTS.map((p, i) => (
              <div
                key={p.id}
                ref={(el) => { panelRefs.current[i] = el; }}
                data-curtain-panel={i}
                className="curtain-panel"
                style={{
                  position: i === 0 ? "relative" : "absolute",
                  inset: i === 0 ? undefined : 0,
                  zIndex: i + 1,
                  willChange: "clip-path",
                }}
              >
                <ProjectCardLarge project={p} priority={i === 0} />
              </div>
            ))}
            {/* seam label — floats at the clip line during transitions */}
            <div
              ref={seamRef}
              aria-hidden
              className="curtain-seam mono"
              style={{
                position: "absolute",
                left: 0,
                right: 0,
                top: "100%",
                padding: "7px 14px",
                fontSize: 11,
                letterSpacing: "0.18em",
                color: "var(--ink)",
                background: CURTAIN_TINTS[1] ?? "#000",
                opacity: 0,
                zIndex: 99,
                pointerEvents: "none",
                willChange: "top, opacity",
              }}
            />
          </div>

          {/* RIGHT — terminal: ls + stats + git log */}
          <div className="hidden md:flex flex-col gap-4">
            <div data-ls-box className="box p-4 mono text-[13px]" style={{ background: "var(--paper-2)" }}>
              <div style={{ color: "var(--accent)" }}>$ ls -la ~/work</div>
              <div className="mute text-[11px] mt-1">total {PROJECTS.length * 8}</div>
              <ul className="mt-2 space-y-0.5">
                {PROJECTS.map((p, i) => {
                  const isActive = i === activeIdx;
                  return (
                    <li key={p.id}>
                      <button
                        data-ls-row
                        data-active={isActive ? "true" : undefined}
                        onClick={() => {
                          const st = stRef.current;
                          if (!st) { setActiveIdx(i); return; }
                          const transitions = Math.max(1, PROJECTS.length - 1);
                          const target = i === 0 ? 0 : Math.min(transitions, i) / transitions;
                          const y = st.start + (st.end - st.start) * target;
                          window.scrollTo({ top: y, behavior: "smooth" });
                        }}
                        className="ls-row no-pop w-full text-left grid items-center gap-3 px-2 py-1 rounded"
                        style={{
                          gridTemplateColumns: "90px 130px 70px 1fr 14px",
                        }}
                      >
                        <span className="mute text-[12px]">drwxr-xr-x</span>
                        <span
                          className="text-[12px]"
                          style={{ color: isActive ? "var(--ink)" : "var(--ink-soft)" }}
                        >
                          {p.kind.toLowerCase()}
                        </span>
                        <span className="mute text-[12px]">{p.date}</span>
                        <span
                          className="truncate"
                          style={{
                            color: isActive ? "var(--ink)" : "var(--ink-soft)",
                            fontWeight: isActive ? 700 : 400,
                          }}
                        >
                          {p.id}/
                        </span>
                        <span style={{ color: isActive ? "var(--accent)" : "transparent" }}>●</span>
                      </button>
                    </li>
                  );
                })}
              </ul>
              <div data-ls-foot className="mute text-[11px] mt-2"># click a folder ↑</div>

              <div
                data-ls-foot
                className="mt-6"
                style={{ color: "var(--accent)" }}
              >
                $ cd <a href="/work">~/work</a>
              </div>
              <div data-ls-foot className="mute text-[11px] mt-1"># click to see all projects</div>
            </div>

          </div>
        </div>
      </div>

      <style jsx>{`
        :global([data-ls-row]) {
          cursor: pointer;
          transition: background-color 0.15s ease, transform 0.15s ease;
        }
        :global([data-ls-row]:hover) {
          background-color: color-mix(in oklab, var(--ink) 6%, transparent);
          transform: translateX(2px);
        }
        :global([data-ls-row][data-active]) {
          background-color: color-mix(in oklab, var(--accent) 8%, transparent);
        }
        :global(.ls-see-all) {
          font-size: 13px;
          transition: color 0.15s ease, transform 0.15s ease;
        }
        :global(.ls-see-all:hover) {
          color: var(--accent-2) !important;
          transform: translateX(2px);
        }
      `}</style>
    </section>
  );
}
